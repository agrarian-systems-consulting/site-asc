---
/**
 * Publications : tous les documents rattachés aux fiches projet (champ `livrables`),
 * regroupés par nature, du plus récent au plus ancien.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Pays from '../components/Pays.astro';
import { descriptionLivrable } from '../lib/projets';

const projets = (await getCollection('projets')).filter((p) => !p.data.draft);

const FAMILLES = [
  { id: 'rapports', titre: 'Rapports et études', types: ['Rapport', 'Étude', 'Note', 'Article'],
    intro: 'Diagnostics agraires, évaluations, études de filière et notes remis à nos commanditaires.' },
  { id: 'outils', titre: 'Outils numériques', types: ['Outil'],
    intro: 'Applications, plateformes et cartes conçues et développées par Asc.' },
  { id: 'formation', titre: 'Supports de formation et manuels', types: ['Support de formation', 'Manuel'],
    intro: 'Cours, travaux dirigés, guides méthodologiques et manuels pédagogiques.' },
  { id: 'presentations', titre: 'Présentations et posters', types: ['Présentation', 'Poster'],
    intro: 'Restitutions d’ateliers, communications et posters.' },
];

const docs = projets
  .flatMap((p) => p.data.livrables.map((l) => ({ p, l })))
  .filter((d, i, arr) => arr.findIndex((x) => x.l.titre === d.l.titre) === i);

const familleDe = (type?: string) => FAMILLES.find((f) => f.types.includes(type ?? ''))?.id ?? 'rapports';
const groupes = FAMILLES.map((f) => ({
  ...f,
  docs: docs
    .filter((d) => familleDe(d.l.type) === f.id)
    .sort((a, b) => (b.l.annee ?? 0) - (a.l.annee ?? 0) || a.l.titre.localeCompare(b.l.titre, 'fr')),
})).filter((g) => g.docs.length > 0);

const nbLibres = docs.filter((d) => d.l.url).length;
const epaisseur = (pages?: number) => (!pages ? 1 : pages < 20 ? 0 : pages < 60 ? 1 : pages < 150 ? 2 : 3);
const classeLiasse = (type?: string, pages?: number) =>
  type === 'Outil' ? 'liasse liasse--ecran'
  : type === 'Présentation' ? `liasse liasse--paysage liasse--${Math.min(epaisseur(pages), 1)}`
  : `liasse liasse--${epaisseur(pages)}`;
---

<BaseLayout title="Publications" description={`${docs.length} rapports, outils numériques et supports de formation produits par Agrarian Systems Consulting, dont ${nbLibres} en libre accès.`}>
  <header class="pub-tete">
    <div class="container">
      <h1>Publications</h1>
      <p class="lead">
        {docs.length} documents produits au fil de nos missions, dont {nbLibres} en libre accès.
        Les autres appartiennent à nos commanditaires : nous les transmettons sur demande quand c’est possible.
      </p>
      <nav class="pub-nav" aria-label="Types de documents">
        {groupes.map((g) => <a href={`#${g.id}`}>{g.titre} <span>{g.docs.length}</span></a>)}
      </nav>
      <label class="pub-filtre">
        <input type="checkbox" id="libres" />
        Afficher seulement les documents en libre accès
      </label>
    </div>
  </header>

  {groupes.map((g) => (
    <section class="pub-groupe" id={g.id}>
      <div class="container">
        <h2>{g.titre}</h2>
        <p class="pub-intro">{g.intro}</p>
        <ol class:list={['etagere', { 'etagere--ecrans': g.id === 'outils' }]}>
          {g.docs.map(({ p, l }) => (
            <li class="doc" data-libre={l.url ? '1' : '0'}>
              <a class="doc-lien" href={l.url ?? `/projets/${p.slug}/#documents`}
                 target={l.url ? '_blank' : undefined} rel={l.url ? 'noopener noreferrer' : undefined}>
                <span class={classeLiasse(l.type, l.pages)}>
                  <img src={l.couverture} alt={`Couverture : ${l.titre}`} loading="lazy" decoding="async" />
                </span>
              </a>
              <p class="doc-titre">{l.titre}</p>
              <p class="doc-desc">{descriptionLivrable(l)}</p>
              <p class="doc-projet">
                <a href={`/projets/${p.slug}/`}>{p.data.title}</a>
              </p>
              <Pays pays={p.data.countries} max={2} />
              {l.url && (
                <a class="doc-action" href={l.url} target="_blank" rel="noopener noreferrer">
                  {l.type === 'Outil' ? 'Ouvrir l’outil' : 'Lire le document'}
                </a>
              )}
            </li>
          ))}
        </ol>
      </div>
    </section>
  ))}
</BaseLayout>

<script>
  const box = document.getElementById('libres') as HTMLInputElement | null;
  box?.addEventListener('change', () => {
    document.body.classList.toggle('pub-libres', box.checked);
  });
</script>

<style>
  .pub-tete { background: var(--color-bg-soft); padding: 4rem 1.5rem 2.5rem; }
  .pub-tete h1 { font-size: clamp(2.2rem, 4vw, 3.2rem); margin: 0 0 1rem; }
  .lead { max-width: 62ch; font-size: 1.1rem; line-height: 1.65; margin: 0 0 2rem; }
  .pub-nav { display: flex; flex-wrap: wrap; gap: 0.6rem 1.75rem; margin-bottom: 1.25rem; }
  .pub-nav a { font-weight: 600; }
  .pub-nav span { font-weight: 400; color: var(--color-muted-text, #5F6A43); margin-left: 0.2rem; }
  .pub-filtre { display: inline-flex; gap: 0.5rem; align-items: center; font-size: 0.95rem; cursor: pointer; }
  .pub-filtre input { accent-color: var(--color-accent-text); width: 1.05rem; height: 1.05rem; }
  :global(body.pub-libres) .doc[data-libre='0'] { display: none; }

  .pub-groupe { padding: 3.5rem 1.5rem 1rem; scroll-margin-top: 80px; }
  .pub-groupe + .pub-groupe { border-top: 1px solid rgba(103, 61, 52, 0.12); }
  .pub-groupe h2 { font-size: clamp(1.5rem, 2.4vw, 2rem); margin: 0 0 0.4rem; }
  .pub-intro { color: var(--color-muted-text, #5F6A43); margin: 0 0 2.25rem; }

  .etagere { list-style: none; margin: 0; padding: 0; display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 2.75rem 2.25rem; align-items: start; }
  .etagere--ecrans { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .doc { display: flex; flex-direction: column; }
  .doc-lien { border: 0; display: block; margin-bottom: 1rem; }
  .liasse { position: relative; display: block; aspect-ratio: 210 / 297; background: #fff;
    box-shadow: 0 1px 1px rgba(64, 40, 30, 0.08), 0 10px 22px -12px rgba(64, 40, 30, 0.45);
    transition: transform 0.25s ease; }
  .liasse img { position: relative; z-index: 2; width: 100%; height: 100%; object-fit: cover; object-position: top;
    display: block; background: #fff; outline: 1px solid rgba(103, 61, 52, 0.1); outline-offset: -1px; }
  .liasse::before, .liasse::after { content: ''; position: absolute; inset: 0; background: #fbf8f2;
    border: 1px solid rgba(103, 61, 52, 0.12); }
  .liasse::before { transform: translate(4px, 4px); z-index: 1; }
  .liasse::after { transform: translate(8px, 8px); z-index: 0; background: #f3ece0; }
  .liasse--0::before, .liasse--0::after, .liasse--1::after { display: none; }
  .liasse--ecran { aspect-ratio: 16 / 11; border-radius: 6px; overflow: hidden; border-top: 14px solid #e6dccb; }
  .liasse--ecran::before, .liasse--ecran::after { display: none; }
  .liasse--paysage { aspect-ratio: 16 / 9; }
  .liasse--paysage img { object-fit: contain; }
  .doc-lien:hover .liasse, .doc-lien:focus-visible .liasse { transform: translateY(-4px) rotate(-0.6deg); }
  .doc-titre { font-family: var(--font-heading); font-variation-settings: 'opsz' 18; font-weight: 600;
    font-size: 0.98rem; line-height: 1.3; margin: 0 0 0.3rem; }
  .doc-desc { font-size: 0.84rem; color: #7a5e53; margin: 0 0 0.35rem; }
  .doc-projet { font-size: 0.84rem; line-height: 1.4; margin: 0 0 0.45rem; }
  .doc-projet { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .doc-projet a { color: var(--color-ink); border-bottom-color: rgba(103, 61, 52, 0.25); }
  .doc-action { font-size: 0.86rem; align-self: flex-start; margin-top: 0.5rem; }
  @media (prefers-reduced-motion: reduce) { .liasse { transition: none; } }
</style>
