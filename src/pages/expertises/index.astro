---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { parRecence, periode } from '../../lib/projets';

const all = (await getCollection('expertises')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const projets = (await getCollection('projets')).filter((p) => !p.data.draft).sort(parRecence);
const pour = (cats: string[]) => projets.filter((p) => p.data.categories.some((c) => cats.includes(c)));
---

<BaseLayout title="Nos métiers" description="Diagnostiquer, dimensionner, suivre et évaluer, capitaliser, outiller, former : les six métiers d'Agrarian Systems Consulting.">
  <header class="x-head">
    <div class="container">
      <h1>Nos métiers</h1>
      <p class="lead">
        Six façons d'intervenir sur un même objet : les systèmes agraires, leurs dynamiques et les projets
        qui cherchent à les faire évoluer. Une mission en combine souvent plusieurs.
      </p>
    </div>
  </header>

  <ol class="container x-liste">
    {all.map((e) => {
      const ps = pour(e.data.related_categories);
      return (
        <li class="x">
          <div class="x-texte">
            <h2><a href={`/expertises/${e.slug}/`}>{e.data.title}</a></h2>
            {e.data.intro && <p>{e.data.intro}</p>}
            <p class="x-n"><a href={`/expertises/${e.slug}/`}>{ps.length} missions</a></p>
          </div>
          <ul class="x-exemples">
            {ps.slice(0, 3).map((p) => (
              <li><a href={`/projets/${p.slug}/`}><span>{periode(p)}, {p.data.countries.join(', ')}</span>{p.data.title}</a></li>
            ))}
          </ul>
        </li>
      );
    })}
  </ol>
</BaseLayout>

<style>
  .x-head { background: var(--color-bg-soft); padding: 4rem 1.5rem 3.5rem; }
  h1 { font-size: clamp(2.2rem, 4.4vw, 3.4rem); font-variation-settings: 'opsz' 60; margin: 0 0 1rem; }
  .lead { font-size: 1.1rem; max-width: 58ch; margin: 0; }
  .x-liste { list-style: none; margin: 0 auto; padding: 3rem 1.5rem 4rem; }
  .x { display: grid; gap: 1.5rem 4rem; padding: 2.5rem 0; border-bottom: 1px solid rgba(103, 61, 52, 0.15); }
  @media (min-width: 900px) { .x { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .x h2 { font-size: clamp(1.6rem, 2.6vw, 2.2rem); font-variation-settings: 'opsz' 48; margin: 0 0 0.75rem; }
  .x h2 a { color: var(--color-ink); border: 0; }
  .x h2 a:hover { color: var(--color-accent); }
  .x-texte p { max-width: 48ch; line-height: 1.6; }
  .x-n { font-size: 0.92rem; font-weight: 600; }
  .x-exemples { list-style: none; margin: 0; padding: 0; align-self: center; }
  .x-exemples a { display: block; border: 0; padding: 0.65rem 0; border-top: 1px solid rgba(103, 61, 52, 0.1); color: var(--color-ink); font-family: var(--font-heading); font-weight: 600; line-height: 1.3; }
  .x-exemples a:hover { color: var(--color-accent); }
  .x-exemples span { display: block; font-family: var(--font-body); font-weight: 500; font-size: 0.82rem; color: var(--color-accent-2); margin-bottom: 0.15rem; }
</style>
