---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const experts = await getCollection('experts');
  return experts.map((expert) => ({
    params: { slug: expert.slug },
    props: { expert },
  }));
}

interface Props { expert: CollectionEntry<'experts'>; }
const { expert } = Astro.props;
const { Content } = await expert.render();
const { name, role, is_gerant, photo, specialities, languages, email, linkedin } = expert.data;

// Projets de cet expert (tri par year_end desc)
const allProjets = await getCollection('projets');
const expertProjets = allProjets
  .filter((p) => !p.data.draft && (p.data.experts ?? []).includes(expert.slug))
  .sort((a, b) => {
    const aEnd = a.data.year_end ?? (a.data.year_start ? 9999 : 0);
    const bEnd = b.data.year_end ?? (b.data.year_start ? 9999 : 0);
    if (bEnd !== aEnd) return bEnd - aEnd;
    return (b.data.year_start ?? 0) - (a.data.year_start ?? 0);
  });

function periodeFor(p: typeof expertProjets[number]) {
  const ys = p.data.year_start; const ye = p.data.year_end;
  if (ys && ye) return `${ys}–${ye}`;
  if (ys && !ye) return `${ys} → en cours`;
  return String(p.data.date.getFullYear());
}
---

<BaseLayout title={name} description={role}>
  <section class="section section--soft expert-head">
    <div class="container expert-head-inner">
      <div class="expert-portrait">
        {photo ? <img src={photo} alt={name} /> : <div class="placeholder">{name.split(' ').map((s) => s[0]).join('').slice(0, 2)}</div>}
      </div>
      <div>
        <p class="eyebrow">{is_gerant ? 'Gérant associé' : 'Collaborateur·rice'}</p>
        <h1>{name}</h1>
        <p class="role">{role}</p>

        <dl class="expert-meta">
          {specialities && specialities.length > 0 && (<><dt>Spécialités</dt><dd>{specialities.join(' · ')}</dd></>)}
          {languages && languages.length > 0 && (<><dt>Langues</dt><dd>{languages.join(' · ')}</dd></>)}
          {email && (<><dt>Email</dt><dd><a href={`mailto:${email}`}>{email}</a></dd></>)}
          {linkedin && (<><dt>LinkedIn</dt><dd><a href={linkedin} target="_blank" rel="noopener">Profil</a></dd></>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container prose-content">
      <Content />
    </div>
  </section>

  {expertProjets.length > 0 && (
    <section class="section section--soft">
      <div class="container">
        <h2 class="proj-title">Missions et projets ({expertProjets.length})</h2>
        <ul class="proj-list">
          {expertProjets.map((p) => (
            <li>
              <a href={`/projets/${p.slug}/`}>
                <div class="proj-meta">
                  <span class="proj-period">{periodeFor(p)}</span>
                  {p.data.countries.length > 0 && (
                    <>
                      <span class="proj-sep"> / </span>
                      <span class="proj-countries">{p.data.countries.join(', ')}</span>
                    </>
                  )}
                </div>
                {p.data.categories.length > 0 && (
                  <p class="proj-tags">{p.data.categories.join(', ')}</p>
                )}
                <h3 class="proj-title-card">{p.data.title}</h3>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section section--white back">
    <div class="container">
      <a href="/equipe/">← Retour à l'équipe</a>
    </div>
  </section>
</BaseLayout>

<style>
  .expert-head { padding-block: 3.5rem; }
  .expert-head-inner {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
    align-items: start;
  }
  .expert-portrait {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-bg);
    flex-shrink: 0;
  }
  .expert-portrait img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .expert-portrait .placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-heading);
    font-size: 3.5rem;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-bg);
  }
  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.5rem;
  }
  h1 {
    font-size: clamp(2rem, 4vw, 2.6rem);
    margin: 0 0 0.4rem;
  }
  .role {
    font-size: 1.05rem;
    font-style: italic;
    color: var(--color-muted);
    margin: 0 0 1.75rem;
  }
  .expert-meta {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.4rem 1.5rem;
    margin: 0;
    max-width: 60ch;
  }
  .expert-meta dt {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }
  .expert-meta dd { margin: 0; color: var(--color-ink); font-size: 0.95rem; }

  .prose-content { max-width: 68ch; margin-inline: auto; }

  .proj-title {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    color: var(--color-accent-2);
    margin: 0 0 2rem;
  }
  .proj-list { list-style: none; padding: 0; margin: 0; }
  .proj-list li { border-bottom: 1px solid rgba(103, 61, 52, 0.12); }
  .proj-list li:first-child { border-top: 1px solid rgba(103, 61, 52, 0.12); }
  .proj-list a {
    display: block;
    padding: 1.25rem 1rem;
    color: inherit;
    border: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .proj-list a:hover { background: var(--color-bg); transform: translateX(4px); color: inherit; }
  .proj-meta { font-size: 0.85rem; color: var(--color-muted); margin-bottom: 0.2rem; }
  .proj-period { font-weight: 600; color: var(--color-accent-2); }
  .proj-countries { color: var(--color-ink); }
  .proj-tags {
    font-size: 0.82rem; color: var(--color-accent);
    margin: 0 0 0.4rem; font-weight: 500;
  }
  .proj-title-card {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    margin: 0;
    color: var(--color-ink);
  }
  .proj-list a:hover .proj-title-card { color: var(--color-accent); }

  .back a { font-weight: 500; font-size: 0.95rem; }

  @media (max-width: 720px) {
    .expert-head-inner { grid-template-columns: 1fr; gap: 1.5rem; }
    .expert-portrait { width: 160px; height: 160px; }
  }
</style>
