---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListeMissions from '../../components/ListeMissions.astro';
import { parRecence } from '../../lib/projets';

export async function getStaticPaths() {
  const experts = await getCollection('experts');
  return experts.map((expert) => ({
    params: { slug: expert.slug },
    props: { expert },
  }));
}

interface Props { expert: CollectionEntry<'experts'>; }
const { expert } = Astro.props;
const { Content } = await expert.render();
const { name, role, is_gerant, photo, specialities, languages, email, linkedin } = expert.data;

// Projets de cet expert (tri par year_end desc)
const allProjets = await getCollection('projets');
const expertProjets = allProjets
  .filter((p) => !p.data.draft && (p.data.experts ?? []).includes(expert.slug))
  .sort(parRecence);

---

<BaseLayout title={name} description={role}>
  <section class="section section--soft expert-head">
    <div class="container expert-head-inner">
      <div class="expert-portrait">
        {photo ? <img src={photo} alt={name} /> : <div class="placeholder">{name.split(' ').map((s) => s[0]).join('').slice(0, 2)}</div>}
      </div>
      <div>
        <h1>{name}</h1>
        <p class="role">{role}</p>

        <dl class="expert-meta">
          {specialities && specialities.length > 0 && (<><dt>Spécialités</dt><dd>{specialities.join(', ')}</dd></>)}
          {languages && languages.length > 0 && (<><dt>Langues</dt><dd>{languages.join(', ')}</dd></>)}
          {email && (<><dt>Email</dt><dd><a href={`mailto:${email}`}>{email}</a></dd></>)}
          {linkedin && (<><dt>LinkedIn</dt><dd><a href={linkedin} target="_blank" rel="noopener">Profil</a></dd></>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container prose-content">
      <Content />
    </div>
  </section>

  {expertProjets.length > 0 && (
    <section class="section section--soft">
      <div class="container">
        <h2 class="proj-title">Missions et projets ({expertProjets.length})</h2>
        <ListeMissions projets={expertProjets} />
      </div>
    </section>
  )}

  <section class="section section--white back">
    <div class="container">
      <a href="/equipe/">← Retour à l'équipe</a>
    </div>
  </section>
</BaseLayout>

<style>
  .expert-head { padding-block: 3.5rem; }
  .expert-head-inner {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
    align-items: start;
  }
  .expert-portrait {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-bg);
    flex-shrink: 0;
  }
  .expert-portrait img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .expert-portrait .placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-heading);
    font-size: 3.5rem;
    font-weight: 600;
    color: var(--color-accent-text);
    background: var(--color-bg);
  }
  h1 {
    font-size: clamp(2rem, 4vw, 2.6rem);
    margin: 0 0 0.4rem;
  }
  .role {
    font-size: 1.05rem;
    font-style: italic;
    color: var(--color-muted-text);
    margin: 0 0 1.75rem;
  }
  .expert-meta {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.4rem 1.5rem;
    margin: 0;
    max-width: 60ch;
  }
  .expert-meta dt {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .expert-meta dd { margin: 0; color: var(--color-ink); font-size: 0.95rem; }

  .prose-content { max-width: 68ch; margin-inline: auto; }

  .proj-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.6vw, 2.15rem);
    font-variation-settings: 'opsz' 48;
    color: var(--color-ink);
    margin: 0 0 2rem;
  }
  .back a { font-weight: 500; font-size: 0.95rem; }

  @media (max-width: 720px) {
    .expert-head-inner { grid-template-columns: 1fr; gap: 1.5rem; }
    .expert-portrait { width: 160px; height: 160px; }
  }
</style>
