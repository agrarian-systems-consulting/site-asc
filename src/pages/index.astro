---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CarteTerrains from '../components/CarteTerrains.astro';
import { periode, parRecence, enCours, visuel } from '../lib/projets';

const all = (await getCollection('projets')).filter((p) => !p.data.draft).sort(parRecence);

const nbPays = new Set(all.flatMap((p) => p.data.countries)).size;

// Missions en cours (ou terminées cette année) : 4 au plus, avec visuel en priorité
const anneeCourante = new Date().getFullYear();
const actuelles = all
  .filter((p) => enCours(p) || (p.data.year_end ?? 0) >= anneeCourante - 1)
  .sort((a, b) => Number(Boolean(visuel(b))) - Number(Boolean(visuel(a))) || parRecence(a, b))
  .slice(0, 4)
  .sort(parRecence);

// Étagère : sélection de couvertures (les plus parlantes), complétée par les plus récentes
const SELECTION = [
  'tapsa/capitalisation-methodologique.jpg',
  'diagnostic-des-dynamiques-agraires-7-regions-du-panama-piasi-preparation/la-pintada.jpg',
  'ecole-terrain-richard-toll-manuel-pedagogique-etudes-systemiques/manuel-apprendre-par-l-action.jpg',
  'diagnostic-agraire-nord-syunik-etude-de-faisabilite-afd/rapport-vorotan-2024.jpg',
  'tapsa/evaluation-impact-kayes.jpg',
  'appui-au-pat-du-pays-barval-arcachon/rapport-foncier-pays-barval.jpg',
  '3-diagnostics-agraires-preparatoires-programme-piasi/toabre-penonome.jpg',
  'coordination-du-projet-fantas-scic-demonstrateur-territorial-transition-agroecol/fiches-techniques-produits.jpg',
  'programme-de-substitution-partielle-du-bois-energie-comme-combustible-de-cuisson-en-rdc/consommation-menages-kinshasa.jpg',
  'diagnostic-des-systemes-agroforestiers-timor-leste/rapport-final-psaf.jpg',
];
const tousDocs = all
  .flatMap((p) => p.data.livrables.map((l) => ({ p, l })))
  .filter((d, i, arr) => arr.findIndex((x) => x.l.titre === d.l.titre) === i); // un document rattaché à deux fiches ne compte qu'une fois
const documents = [
  ...SELECTION.map((c) => tousDocs.find((d) => d.l.couverture === `/livrables/${c}`)).filter((d): d is NonNullable<typeof d> => Boolean(d)),
  ...tousDocs.filter((d) => !SELECTION.some((c) => d.l.couverture === `/livrables/${c}`)),
].slice(0, 10);
const nbDocs = tousDocs.length;
// Pays affiché sous une couverture : celui cité dans le titre, sinon le pays unique, sinon rien de trop long
const lieu = (pays: string[], titre: string) =>
  pays.find((c) => titre.includes(c)) ?? (pays.length <= 2 ? pays.join(', ') : `${pays.length} pays`);

// Commanditaires cités (premier nom avant « / » ou « & »), dédupliqués, par fréquence
const freq = new Map<string, number>();
for (const p of all) {
  for (const raw of (p.data.client ?? '').split(/\s*[\/&]\s*|\s+-\s+/)) {
    const c = raw.replace(/\s*\(.*?\)\s*/g, '').trim();
    if (!c || /Agrarian Systems|^Bailleurs$/i.test(c)) continue;
    freq.set(c, (freq.get(c) ?? 0) + 1);
  }
}
const commanditaires = [...freq.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'fr')).map(([c]) => c);

const LOGOS = [
  { f: 'cirad', nom: 'CIRAD' }, { f: 'bid', nom: 'Banque interaméricaine de développement' },
  { f: 'afd', nom: 'Agence française de développement' }, { f: 'ccfd-terre-solidaire', nom: 'CCFD-Terre Solidaire' },
  { f: 'institut-agro-montpellier', nom: "L'Institut Agro Montpellier" }, { f: 'idiap', nom: 'IDIAP Panama' },
  { f: 'cifor', nom: 'CIFOR' }, { f: 'banque-des-territoires', nom: 'Banque des Territoires' },
  { f: 'pnud', nom: 'PNUD' }, { f: 'montpellier-supagro', nom: 'Montpellier SupAgro' },
  { f: 'lfs', nom: 'LFS Financial Systems' }, { f: 'wwf', nom: 'WWF' },
  { f: 'cfppa-carmejane', nom: 'CFPPA de Carmejane' }, { f: 'dgacta', nom: 'DGACTA Tunisie' },
  { f: 'graines-equitables', nom: 'SCIC Graines équitables' }, { f: 'ussein', nom: 'USSEIN' },
];
const avecLogo = /CIRAD|BID|^AFD|CCFD|Institut Agro|IDIAP|CIFOR|Banque des Territoires|PNUD|SupAgro|LFS|WWF|Carmejane|DGACTA|Graines|USSEIN|Sine Saloum/i;
const autres = commanditaires.filter((c) => !avecLogo.test(c));

const compte = (cats: string[]) => all.filter((p) => p.data.categories.some((c) => cats.includes(c))).length;
---

<BaseLayout title="Accueil" description="Agrarian Systems Consulting, bureau d'étude des systèmes agraires et alimentaires : diagnostic agraire, suivi-évaluation, agroforesterie, formation et outils numériques, en France et dans les pays du Sud.">
  <section class="hero">
    <div class="hero-carte" aria-hidden="false">
      <CarteTerrains projets={all}><Fragment slot="legende"> </Fragment></CarteTerrains>
    </div>
    <div class="container hero-texte">
      <h1>Comprendre les agricultures pour mieux accompagner leurs transitions.</h1>
      <p class="hero-lead">
        Agrarian Systems Consulting est un bureau d'étude de l'économie sociale et solidaire.
        Nous diagnostiquons des systèmes agraires, évaluons des programmes, formons des
        professionnels et développons des outils numériques, des zones arides du Sahel
        aux forêts du bassin du Congo, de l'isthme de Panama aux campagnes françaises.
      </p>
      <p class="hero-actions">
        <a class="btn btn-primary" href="/projets/references/">Parcourir nos {all.length} références</a>
        <a class="lien-simple" href="/territoires/">{nbPays} pays d'intervention</a>
      </p>
    </div>
  </section>

  <section class="actuelles">
    <div class="container">
      <h2>En ce moment</h2>
      <ul class="act-liste">
        {actuelles.map((p) => {
          const v = visuel(p);
          return (
            <li>
              <a href={`/projets/${p.slug}/`}>
                <span class:list={['act-visuel', v && `act-visuel--${v.kind}`]}>
                  {v ? <img src={v.src} alt="" loading="lazy" decoding="async" /> : <span class="act-vide">{p.data.countries[0] ?? ''}</span>}
                </span>
                <span class="act-meta">{periode(p, 'long')}{p.data.countries.length > 0 && <>, {p.data.countries.join(', ')}</>}</span>
                <span class="act-titre">{p.data.title}</span>
                {p.data.client && <span class="act-client">Pour {p.data.client}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  {documents.length >= 3 && (
    <section class="documents">
      <div class="container">
        <div class="doc-entete">
          <h2>Ce que nous produisons</h2>
          <p>Rapports de diagnostic, manuels, supports de formation : {nbDocs} documents remis à nos commanditaires sont présentés dans les fiches projet. En voici quelques-uns.</p>
          <p><a href="/publications/">Voir toutes nos publications</a></p>
        </div>
        <ul class="etagere">
          {documents.map(({ p, l }) => (
            <li>
              <a href={`/projets/${p.slug}/`}>
                <span class="couv"><img src={l.couverture} alt="" loading="lazy" decoding="async" /></span>
                <span class="couv-titre">{l.titre}</span>
                <span class="couv-projet">{lieu(p.data.countries, l.titre)}{l.annee ? `, ${l.annee}` : ''}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}


  <section class="clients" aria-labelledby="clients-titre">
    <div class="container">
      <h2 id="clients-titre">Ils nous ont confié des missions</h2>
    </div>
    <div class="defile" tabindex="0" aria-label="Logos de nos commanditaires">
      <ul class="defile-piste">
        {[...LOGOS, ...LOGOS].map((l, i) => (
          <li aria-hidden={i >= LOGOS.length ? 'true' : undefined}>
            <img src={`/logos/${l.f}.png`} alt={i >= LOGOS.length ? '' : l.nom} loading="lazy" decoding="async" />
          </li>
        ))}
      </ul>
    </div>
    <p class="container cl-autres">Et aussi : {autres.join(', ')}.</p>
  </section>
</BaseLayout>

<style>
  h2 {
    font-size: clamp(1.6rem, 2.6vw, 2.15rem);
    font-variation-settings: 'opsz' 48;
    margin: 0 0 2rem;
  }

  /* ── Hero : texte à gauche, carte à droite (sans chevauchement) ── */
  .hero { position: relative; background: var(--color-bg-soft); padding: 4.5rem 1.5rem 3.5rem; overflow: hidden; }
  .hero-carte { position: relative; }
  .hero-texte { position: relative; z-index: 1; pointer-events: none; }
  .hero-texte :is(a, .btn) { pointer-events: auto; }
  @media (min-width: 1000px) {
    .hero { display: grid; grid-template-columns: minmax(0, 30rem) minmax(0, 1fr); gap: 2.5rem; align-items: center;
            padding: 4rem 1rem 4rem max(1.5rem, calc((100vw - 1200px) / 2)); }
    .hero-carte { grid-column: 2; grid-row: 1; }
    .hero-texte { grid-column: 1; grid-row: 1; padding: 0; margin: 0; max-width: none; }
  }
  .hero h1 {
    font-size: clamp(2.3rem, 4.8vw, 3.9rem);
    font-variation-settings: 'opsz' 60;
    letter-spacing: -0.015em;
    line-height: 1.04;
    max-width: 17ch;
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }
  .hero-lead { font-size: 1.1rem; line-height: 1.7; max-width: 54ch; }
  .hero-actions { display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap; margin-top: 2rem; }
  .btn {
    display: inline-block; padding: 0.8rem 1.35rem; border-radius: 4px; font-weight: 600; font-size: 0.98rem;
    background: var(--color-accent-text); color: #fff; border: 0;
  }
  .btn:hover { background: var(--color-ink); color: #fff; }
  .btn:focus-visible, .lien-simple:focus-visible { outline: 2px solid var(--color-accent-2); outline-offset: 3px; }
  .lien-simple { font-weight: 600; color: var(--color-accent-2); }

  /* ── En ce moment ── */
  .actuelles { padding: 5rem 1.5rem 4rem; }
  .act-liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.5rem 2rem; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .act-liste a { display: flex; flex-direction: column; border: 0; color: var(--color-ink); }
  .act-visuel {
    display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--color-bg-soft); margin-bottom: 1rem; border-radius: 2px;
  }
  .act-visuel img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
  .act-visuel--couverture { display: grid; place-items: center; padding: 1.25rem 0 0; }
  .act-visuel--couverture img {
    width: 52%; height: auto; aspect-ratio: 210 / 297; object-position: top; align-self: end;
    box-shadow: 0 10px 20px -10px rgba(64, 40, 30, 0.5);
  }
  .act-vide { display: grid; place-items: center; height: 100%; font-family: var(--font-heading); font-size: 1.6rem; color: var(--color-muted-text); }
  .act-liste a:hover .act-visuel--photo img { transform: scale(1.03); }
  .act-meta { font-size: 0.85rem; color: var(--color-accent-2); font-weight: 500; }
  .act-titre { font-family: var(--font-heading); font-weight: 600; font-size: 1.15rem; line-height: 1.3; margin-top: 0.35rem; text-wrap: pretty; }
  .act-liste a:hover .act-titre { color: var(--color-accent-text); }
  .act-client { font-size: 0.88rem; color: #7a5e53; margin-top: 0.4rem; }
  @media (prefers-reduced-motion: reduce) { .act-visuel img { transition: none; } }

  /* ── Étagère de documents ── */
  .documents { background: var(--color-accent-2); color: #f7f0e3; padding: 4.5rem 1.5rem 5rem; }
  .documents h2 { color: #f7f0e3; margin-bottom: 0.75rem; }
  .doc-entete p { max-width: 56ch; color: rgba(247, 240, 227, 0.8); margin-bottom: 2.75rem; }
  .documents .etagere {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 2.75rem 2.25rem; align-items: start;
  }
  .documents a { display: flex; flex-direction: column; border: 0; color: #f7f0e3; }
  .couv { display: block; aspect-ratio: 210 / 297; background: #fff; box-shadow: 0 14px 24px -14px rgba(0, 0, 0, 0.7); transition: transform 0.25s ease; }
  .couv img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .documents a:hover .couv { transform: translateY(-5px) rotate(-0.8deg); }
  .couv-titre { font-family: var(--font-heading); font-weight: 600; font-size: 0.98rem; line-height: 1.3; margin-top: 1rem; }
  .couv-projet { font-size: 0.8rem; color: rgba(247, 240, 227, 0.7); margin-top: 0.3rem; }
  @media (max-width: 900px) { .documents .etagere { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .documents .etagere { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (prefers-reduced-motion: reduce) { .couv { transition: none; } }

  .met-grille { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.75rem; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .met-grille a {
    display: flex; flex-direction: column; height: 100%; border: 1px solid rgba(103, 61, 52, 0.14); border-radius: 4px;
    overflow: hidden; color: var(--color-ink); background: #fff; transition: border-color .2s ease;
  }
  .met-grille a:hover { border-color: rgba(103, 61, 52, 0.35); }
  .met-img { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--color-bg-soft); }
  .met-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
  .met-grille a:hover .met-img img { transform: scale(1.04); }
  .met-corps { display: flex; flex-direction: column; gap: 0.6rem; padding: 1.35rem 1.5rem 1.4rem; flex: 1; }
  .met-titre { font-family: var(--font-heading); font-variation-settings: 'opsz' 40; font-size: 1.45rem; font-weight: 600; line-height: 1.2; }
  .met-grille a:hover .met-titre { color: var(--color-accent-text); }
  .met-intro { line-height: 1.55; font-size: 0.97rem; flex: 1; }
  .met-n { font-size: 0.86rem; font-weight: 600; color: var(--color-accent-2); padding-top: 0.75rem; border-top: 1px solid rgba(103, 61, 52, 0.1); }
  @media (prefers-reduced-motion: reduce) { .met-img img { transition: none; } }

  /* ── Commanditaires : défilement de logos ── */
  .clients { padding: 3.5rem 0 4.5rem; }
  .clients h2 { margin-bottom: 2.25rem; }
  .clients .container { padding-inline: 1.5rem; }
  .defile {
    overflow: hidden; position: relative;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .defile-piste { list-style: none; margin: 0; padding: 0.5rem 0; display: flex; gap: 4.5rem; width: max-content; animation: defile 60s linear infinite; }
  .defile:hover .defile-piste, .defile:focus-within .defile-piste { animation-play-state: paused; }
  .defile-piste li { flex: none; display: grid; place-items: center; height: 72px; }
  .defile-piste img { max-height: 64px; max-width: 170px; width: auto; height: auto; filter: grayscale(1) sepia(.25); opacity: .72; transition: filter .25s ease, opacity .25s ease; }
  .defile-piste li:hover img { filter: none; opacity: 1; }
  @keyframes defile { to { transform: translateX(calc(-50% - 2.25rem)); } }
  @media (prefers-reduced-motion: reduce) {
    .defile { -webkit-mask-image: none; mask-image: none; }
    .defile-piste { animation: none; flex-wrap: wrap; width: auto; justify-content: center; padding-inline: 1.5rem; }
    .defile-piste li[aria-hidden='true'] { display: none; }
  }
  .cl-autres { margin-top: 2.25rem; font-size: 0.92rem; color: var(--color-muted-text, #5F6A43); line-height: 1.6; max-width: 1200px; }
</style>
