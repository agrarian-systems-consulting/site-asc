---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((projet) => ({
    params: { slug: projet.slug },
    props: { projet },
  }));
}

interface Props { projet: CollectionEntry<'projets'>; }
const { projet } = Astro.props;
const { Content } = await projet.render();
const {
  title, date, excerpt, categories, tags, countries, featured_image, legacyUrl,
  year_start, year_end, client, filieres, video_url, ressources, is_projet,
  experts: expertSlugs,
} = projet.data;

// Récupère les fiches expertes correspondantes
const allExperts = await getCollection('experts');
const projectExperts = (expertSlugs || [])
  .map((s) => allExperts.find((e) => e.slug === s))
  .filter((e): e is NonNullable<typeof e> => Boolean(e))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const dateFmt = new Intl.DateTimeFormat('fr-FR', { year: 'numeric', month: 'long' }).format(date);
const periode = year_start && year_end
  ? `${year_start}–${year_end}`
  : year_start && !year_end
    ? `${year_start} → en cours`
    : dateFmt;

// Convertit URL YouTube/Vimeo en URL embed
function toEmbed(url?: string): string | null {
  if (!url) return null;
  const yt = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]+)/);
  if (yt) return `https://www.youtube.com/embed/${yt[1]}`;
  const vm = url.match(/vimeo\.com\/(\d+)/);
  if (vm) return `https://player.vimeo.com/video/${vm[1]}`;
  return url;
}
const videoEmbed = toEmbed(video_url);

// Icônes SVG au trait (couleur terre cuite via currentColor) pour la section Ressources
const RESSOURCE_ICONS: Record<string, string> = {
  pdf: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M12 11.5v5"/><path d="m9.5 14 2.5 2.5 2.5-2.5"/>',
  doc: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 12.5h6"/><path d="M9 15.5h6"/><path d="M9 18.5h3.5"/>',
  tableur: '<rect x="4" y="5" width="16" height="14" rx="2"/><path d="M4 10h16"/><path d="M4 14.5h16"/><path d="M9.5 10v9"/><path d="M14.5 10v9"/>',
  presentation: '<rect x="3.5" y="4" width="17" height="12.5" rx="2"/><path d="M8 12.5V11"/><path d="M12 12.5V9"/><path d="M16 12.5V7.5"/><path d="M12 16.5V20"/><path d="M9 20h6"/>',
  image: '<rect x="4" y="5" width="16" height="14" rx="2"/><circle cx="9" cy="10" r="1.4"/><path d="m4.5 16.5 4-3.5 3 2.2 4-4 4 3.3"/>',
  video: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9.2 5 2.8-5 2.8z"/>',
  lien: '<path d="M9.5 13a3.5 3.5 0 0 0 5 0l2.5-2.5a3.5 3.5 0 0 0-5-5l-1 1"/><path d="M14.5 11a3.5 3.5 0 0 0-5 0L7 13.5a3.5 3.5 0 0 0 5 5l1-1"/>',
  autre: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>',
};
const iconFor = (type?: string) => RESSOURCE_ICONS[type ?? 'autre'] ?? RESSOURCE_ICONS.autre;
---

<BaseLayout title={title} description={excerpt} image={featured_image}>
  <article>
    <!-- Header projet (fond lin) -->
    <section class="section section--soft project-head">
      <div class="container">
        <p class="eyebrow">
          {is_projet ? 'Projet' : 'Référence'} · {periode}
        </p>
        <h1>{title}</h1>
        {excerpt && <p class="lead">{excerpt}</p>}

        <dl class="project-meta">
          {client && (<><dt>Commanditaire</dt><dd>{client}</dd></>)}
          {countries.length > 0 && (<><dt>Pays</dt><dd>{countries.join(', ')}</dd></>)}
          {categories.length > 0 && (<><dt>Thématique{categories.length > 1 ? 's' : ''}</dt><dd>{categories.join(', ')}</dd></>)}
          {filieres.length > 0 && (<><dt>Filière{filieres.length > 1 ? 's' : ''}</dt><dd>{filieres.join(', ')}</dd></>)}
        </dl>
      </div>
    </section>

    <!-- Image héro -->
    {featured_image && (
      <section class="section section--white" style="padding-block:0;">
        <div class="container hero-img-wrap">
          <img src={featured_image} alt="" loading="eager" />
        </div>
      </section>
    )}

    <!-- Vidéo (si présente) -->
    {videoEmbed && (
      <section class="section section--white video-section">
        <div class="container">
          <div class="video-wrap">
            <iframe
              src={videoEmbed}
              title={`Vidéo - ${title}`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>
      </section>
    )}

    <!-- Corps (fond blanc) -->
    <section class="section section--white">
      <div class="container prose-content">
        <Content />

        {legacyUrl && (
          <p class="legacy">
            <small>
              <a href={legacyUrl} rel="nofollow">Voir la page d'origine (archive)</a>
            </small>
          </p>
        )}
      </div>
    </section>

    <!-- Ressources téléchargeables (ancre stable #ressources) -->
    {ressources && ressources.length > 0 && (
      <section class="section section--white ressources-section" id="ressources">
        <div class="container">
          <div class="ressources-card">
            <h2 class="ressources-title">Ressources</h2>
            <p class="ressources-sub">Documents accessibles et téléchargeables liés à ce projet.</p>
            <ul class="ressources-list">
              {ressources.map((r) => (
                <li class="ressource">
                  <a href={r.url} target="_blank" rel="noopener noreferrer">
                    <span class="ressource-ico" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${iconFor(r.type)}</svg>`}></span>
                    <span class="ressource-titre">{r.titre}</span>
                    <span class="ext" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    <!-- Experts mobilisés (fond lin) -->
    {projectExperts.length > 0 && (
      <section class="section section--soft experts-section">
        <div class="container">
          <h2 class="experts-title">Experts mobilisés sur ce projet</h2>
          <ul class="experts-grid">
            {projectExperts.map((e) => (
              <li class="expert-card">
                <a href={`/equipe/${e.slug}/`}>
                  <div class="expert-photo">
                    {e.data.photo ? (
                      <img src={e.data.photo} alt={e.data.name} loading="lazy" />
                    ) : (
                      <div class="expert-photo-placeholder">{e.data.name.split(' ').map((s) => s[0]).join('').slice(0, 2)}</div>
                    )}
                  </div>
                  <p class="expert-name">{e.data.name}</p>
                  <p class="expert-role">{e.data.role}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- Retour -->
    <section class="section section--white back">
      <div class="container">
        <a href={is_projet ? '/projets/' : '/projets/references/'}>← Retour</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .project-head { padding-block: 4rem; }
  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0.5rem 0 1rem;
    max-width: 50ch;
    line-height: 1.15;
  }
  .lead {
    font-size: 1.15rem;
    max-width: 60ch;
    opacity: 0.85;
  }
  .project-meta {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.4rem 1.5rem;
    margin: 2rem 0 0;
    max-width: 60ch;
  }
  .project-meta dt {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }
  .project-meta dd {
    margin: 0;
    color: var(--color-ink);
    font-size: 0.95rem;
  }

  /* Vidéo embed */
  .video-section { padding-block: 3rem; }
  .video-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(103, 61, 52, 0.15);
    background: #000;
  }
  .video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Ressources téléchargeables */
  .ressources-section { scroll-margin-top: 90px; }   /* décale l'ancre #ressources sous le header sticky */
  .ressources-card {
    max-width: 68ch;
    margin-inline: auto;
    padding: 1.75rem 2rem;
    background: var(--color-bg-soft);
    border-left: 4px solid var(--color-accent);
    border-radius: 4px;
  }
  .ressources-title {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    margin: 0 0 0.25rem;
    color: var(--color-accent-2);
  }
  .ressources-sub {
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .ressources-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .ressource { display: block; }
  .ressource a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    border: none;
    color: var(--color-ink);
    font-weight: 600;
    padding: 0.5rem 0.6rem;
    border-radius: 10px;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .ressource a:hover {
    color: var(--color-accent);
    background: rgba(199, 86, 40, 0.05);
  }
  /* Badge organique terre cuite */
  .ressource-ico {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 12px;
    background: rgba(199, 86, 40, 0.08);
    border: 1px solid rgba(199, 86, 40, 0.14);
    color: var(--color-accent);
    transition: background 0.18s ease, border-color 0.18s ease;
  }
  .ressource a:hover .ressource-ico {
    background: rgba(199, 86, 40, 0.16);
    border-color: rgba(199, 86, 40, 0.28);
  }
  .ressource-ico svg {
    width: 20px;
    height: 20px;
    display: block;
  }
  .ressource-titre {
    flex: 1 1 auto;
    line-height: 1.35;
  }
  .ressource .ext {
    flex: none;
    font-size: 0.8rem;
    color: var(--color-accent);
    opacity: 0.5;
    transition: opacity 0.15s ease;
  }
  .ressource a:hover .ext { opacity: 1; }
  .hero-img-wrap img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin-top: -3rem;
    box-shadow: 0 10px 30px rgba(103, 61, 52, 0.12);
  }
  .prose-content { max-width: 68ch; margin-inline: auto; }
  .legacy {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(103, 61, 52, 0.1);
    opacity: 0.6;
  }
  .back a { font-weight: 500; font-size: 0.95rem; }

  /* Experts mobilisés */
  .experts-section { padding-block: 3.5rem; }
  .experts-title {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    color: var(--color-accent-2);
    margin: 0 0 2rem;
  }
  .experts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .expert-card a {
    display: block;
    text-align: center;
    border: none;
    color: var(--color-ink);
    padding: 1rem 0.5rem;
    border-radius: 8px;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .expert-card a:hover {
    background: var(--color-bg);
    transform: translateY(-2px);
    color: var(--color-accent);
  }
  .expert-photo {
    width: 96px;
    height: 96px;
    margin: 0 auto 0.75rem;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-bg-soft);
  }
  .expert-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .expert-photo-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-bg-soft);
  }
  .expert-name {
    font-weight: 700;
    margin: 0 0 0.15rem;
    font-size: 0.95rem;
    color: var(--color-ink);
  }
  .expert-card a:hover .expert-name { color: var(--color-accent); }
  .expert-role {
    font-size: 0.78rem;
    color: var(--color-muted);
    font-style: italic;
    margin: 0;
  }
</style>
