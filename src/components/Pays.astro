---
/** Badges pays, colorés par continent. */
import { continent } from '../lib/continents';
interface Props { pays: string[]; max?: number; lien?: boolean }
const { pays, max = 99, lien = false } = Astro.props;
const visibles = pays.slice(0, max);
const reste = pays.length - visibles.length;
---

<span class="pays">
  {visibles.map((p) => {
    const c = continent(p);
    return lien
      ? <a class={`badge badge--${c}`} href={`/projets/references/?pays=${encodeURIComponent(p)}`}>{p}</a>
      : <span class={`badge badge--${c}`}>{p}</span>;
  })}
  {reste > 0 && <span class="badge badge--plus">+{reste}</span>}
</span>

<style>
  .pays { display: inline-flex; flex-wrap: wrap; gap: 0.3rem; vertical-align: middle; }
  .badge {
    display: inline-block; font-family: var(--font-body); font-size: 0.76rem; font-weight: 600; line-height: 1;
    padding: 0.32rem 0.55rem 0.3rem; border-radius: 999px; white-space: nowrap; border: 0;
  }
  a.badge:hover { filter: brightness(0.95); }
  /* Afrique : terre cuite */
  .badge--afrique { background: #f6dccf; color: #8a3a17; }
  /* Amériques : haricot vert */
  .badge--ameriques { background: #e1e6cf; color: #3a4a1f; }
  /* Asie : lentille corail */
  .badge--asie { background: #fbe2bf; color: #7d4608; }
  /* Europe : lentille brune */
  .badge--europe { background: #eadfd9; color: #5a342c; }
  /* Océanie : pois cassé bleuté */
  .badge--oceanie { background: #dbe6e4; color: #2f4f4a; }
  .badge--autre, .badge--plus { background: #ece7dc; color: #5a4a40; }
</style>
