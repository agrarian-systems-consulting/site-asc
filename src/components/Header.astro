---
type NavChild = { href: string; label: string; description?: string };
type NavItem = {
  href: string;
  label: string;
  intro?: string;
  children?: NavChild[];
};

const nav: NavItem[] = [
  { href: '/', label: 'Accueil' },
  {
    href: '/bureau-detude/',
    label: 'Qui sommes-nous',
    intro: 'Découvrez le bureau d’étude et l’équipe qui le compose.',
    children: [
      { href: '/bureau-detude/', label: 'Le bureau', description: 'Notre histoire, notre approche, nos valeurs' },
      { href: '/equipe/', label: 'Notre équipe', description: 'Les femmes et les hommes du bureau d’étude' },
    ],
  },
  { href: '/expertises/', label: 'Expertises' },
  {
    href: '/projets/',
    label: 'Projets',
    intro: 'Explorez nos missions à travers le monde.',
    children: [
      { href: '/projets/', label: 'Projets pluriannuels', description: 'Les programmes que nous accompagnons dans la durée' },
      { href: '/projets/references/', label: 'Toutes nos références', description: 'Liste filtrable par pays, thématique et filière' },
    ],
  },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
const isParentActive = (item: NavItem) =>
  isActive(item.href) || (item.children?.some((c) => isActive(c.href)) ?? false);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Agrarian Systems Consulting - Accueil">
      <img src="/brand/Logo_asc_vert.svg" alt="Agrarian Systems Consulting" class="brand-logo" />
    </a>
    <nav aria-label="Navigation principale">
      <ul class="nav-list">
        {nav.map((item) => (
          <li class:list={['nav-item', { 'has-submenu': !!item.children }]}>
            <a
              href={item.href}
              class:list={['nav-link', { active: isParentActive(item) }]}
              aria-haspopup={item.children ? 'true' : undefined}
            >
              <span class="nav-link-text">{item.label}</span>
            </a>
            {item.children && (
              <div class="megamenu" role="menu" aria-label={item.label}>
                <div class="megamenu-inner">
                  <div class="megamenu-heading">
                    <h3>{item.label}</h3>
                    {item.intro && <p>{item.intro}</p>}
                  </div>
                  <ul class="megamenu-list">
                    {item.children.map((child) => (
                      <li role="none">
                        <a
                          role="menuitem"
                          href={child.href}
                          class:list={['megamenu-link', { active: isActive(child.href) }]}
                        >
                          <span class="megamenu-link-title">{child.label}</span>
                          {child.description && (
                            <span class="megamenu-link-desc">{child.description}</span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-bg);
    border-bottom: 1px solid rgba(103, 61, 52, 0.1);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    /* nav-item ne doit PAS être positioned pour que le megamenu s'ancre au header */
  }
  .brand {
    display: block;
    border: none;
    flex-shrink: 0;
  }
  .brand-logo {
    height: 52px;
    width: auto;
    display: block;
  }
  @media (max-width: 480px) {
    .brand-logo { height: 42px; }
  }

  .nav-list {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-item {
    /* PAS de position:relative — sinon le megamenu se cale sous l'item au lieu du header */
    /* Étend la zone de hover verticalement pour couvrir le padding du header
       et chevaucher le haut du megamenu (sans changer le rendu visuel). */
    padding-block: 1rem;
    margin-block: -1rem;
  }
  .nav-link {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-ink);
    border: none;
    padding: 0.25rem 0;
    transition: color 0.2s ease;
  }
  /* Barre dynamique (style référence Salient) */
  .nav-link-text {
    position: relative;
    display: inline-block;
  }
  .nav-link-text::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s cubic-bezier(0.25, 0, 0.4, 1);
  }
  .nav-link:hover { color: var(--color-accent); }
  .nav-item:hover .nav-link-text::after,
  .nav-link:focus-visible .nav-link-text::after,
  .nav-link.active .nav-link-text::after {
    transform: scaleX(1);
  }
  .nav-link.active { color: var(--color-accent); }

  /* ──────────── MEGA-MENU centré, largeur contenue ──────────── */
  .megamenu {
    position: absolute;
    top: 100%;                /* sous le header */
    left: 50%;
    /* ~82% de l'écran, capé à 1240px, marges latérales mini sur petits écrans */
    width: min(1240px, calc(100% - 3rem));
    background: var(--color-bg);
    border-radius: 4px;
    box-shadow: 0 6px 28px rgba(0, 0, 0, 0.08);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, 8px);
    /* État fermé : 200ms de grâce avant de disparaître si le hover s'absente brièvement */
    transition: opacity 0.25s cubic-bezier(0.25, 0, 0.4, 1) 0.2s,
                transform 0.25s cubic-bezier(0.25, 0, 0.4, 1) 0.2s,
                visibility 0.4s 0.2s;
    z-index: 60;
  }
  /* Zone tampon élargie entre le lien parent et le panneau (filet de sécurité) */
  .megamenu::before {
    content: "";
    position: absolute;
    top: -24px;
    left: 0;
    right: 0;
    height: 24px;
  }
  .nav-item.has-submenu:hover .megamenu,
  .nav-item.has-submenu:focus-within .megamenu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
    /* État ouvert : pas de délai à l'ouverture */
    transition-delay: 0s;
  }

  .megamenu-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    padding: 2.5rem 1.5rem;
    align-items: start;
  }
  .megamenu-heading h3 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-accent-2);
    margin: 0 0 0.5rem;
  }
  .megamenu-heading p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-ink);
    opacity: 0.75;
  }
  .megamenu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }
  .megamenu-link {
    display: block;
    padding: 1rem 1.25rem;
    border: none;
    border-radius: 4px;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .megamenu-link:hover,
  .megamenu-link:focus-visible {
    background: var(--color-bg-soft);
  }
  .megamenu-link-title {
    display: block;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.25rem;
    transition: color 0.18s ease;
  }
  .megamenu-link:hover .megamenu-link-title,
  .megamenu-link.active .megamenu-link-title {
    color: var(--color-accent);
  }
  .megamenu-link-desc {
    display: block;
    font-size: 0.85rem;
    color: var(--color-ink);
    opacity: 0.7;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .megamenu-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.75rem 1.5rem;
    }
  }
  @media (max-width: 768px) {
    .header-inner { flex-direction: column; gap: 0.75rem; padding: 1rem; }
    .nav-list { flex-wrap: wrap; justify-content: center; gap: 1rem; }
    /* mobile: dropdown inline simple, on annule tout le positionnement absolu */
    .megamenu,
    .nav-item.has-submenu:hover .megamenu,
    .nav-item.has-submenu:focus-within .megamenu {
      position: static;
      width: auto;
      left: auto;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none;
      box-shadow: none;
      background: transparent;
      border-radius: 0;
    }
    .megamenu::before { display: none; }
    .megamenu-inner {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding: 0.25rem 0 0;
    }
    .megamenu-heading { display: none; }
    .megamenu-list { grid-template-columns: 1fr; gap: 0.25rem; }
    .megamenu-link { padding: 0.4rem 0.6rem; text-align: center; }
    .megamenu-link-desc { display: none; }
  }
</style>
