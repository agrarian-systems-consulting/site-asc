---
import type { CollectionEntry } from 'astro:content';
import { periode } from '../lib/projets';

interface Props { projets: CollectionEntry<'projets'>[] }
const { projets } = Astro.props;
---

<ul class="lm">
  {projets.map((p) => {
    const couv = p.data.livrables?.[0]?.couverture;
    return (
      <li>
        <a href={`/projets/${p.slug}/`}>
          <span class="lm-an">{periode(p)}</span>
          <span class="lm-corps">
            <span class="lm-titre">{p.data.title}</span>
            <span class="lm-sub">
              {p.data.countries.length > 0 && <span class="lm-pays">{p.data.countries.join(', ')}</span>}
              {p.data.client && <span>{p.data.client}</span>}
            </span>
          </span>
          <span class="lm-doc" aria-hidden="true">{couv && <img src={couv} alt="" loading="lazy" decoding="async" />}</span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .lm { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(103, 61, 52, 0.15); }
  .lm li { border-bottom: 1px solid rgba(103, 61, 52, 0.12); }
  .lm a {
    display: grid; grid-template-columns: 7.5rem minmax(0, 1fr) 50px; gap: 1.5rem; align-items: center;
    padding: 1.05rem 0.25rem; border: 0; color: var(--color-ink);
  }
  .lm-an { font-size: 0.9rem; font-weight: 600; color: var(--color-accent-2); font-variant-numeric: tabular-nums; align-self: start; padding-top: 0.15rem; }
  .lm-titre { display: block; font-family: var(--font-heading); font-size: 1.12rem; font-weight: 600; line-height: 1.3; text-wrap: pretty; }
  .lm-sub { display: block; font-size: 0.86rem; color: #866a5f; margin-top: 0.25rem; }
  .lm-pays { color: var(--color-ink); font-weight: 500; margin-right: 1rem; }
  .lm a:hover .lm-titre { color: var(--color-accent); }
  .lm-doc img {
    display: block; width: 50px; aspect-ratio: 210 / 297; object-fit: cover; object-position: top; background: #fff;
    box-shadow: 0 1px 1px rgba(64, 40, 30, 0.1), 0 6px 12px -6px rgba(64, 40, 30, 0.4);
  }
  @media (max-width: 640px) {
    .lm a { grid-template-columns: minmax(0, 1fr) 42px; gap: 0.25rem 1rem; }
    .lm-an { grid-column: 1 / -1; padding: 0; }
    .lm-doc img { width: 42px; }
  }
</style>
