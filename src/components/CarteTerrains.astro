---
/**
 * Carte des terrains : pays où Asc est intervenu, calculée au build depuis
 * les fiches projet (champ `countries`). SVG statique, aucun JS côté client.
 */
import { geoEqualEarth, geoPath, geoCentroid } from 'd3-geo';
import { feature } from 'topojson-client';
import world from 'world-atlas/countries-110m.json';
import type { CollectionEntry } from 'astro:content';

interface Props { projets: CollectionEntry<'projets'>[] }
const { projets } = Astro.props;

// Nom français utilisé dans les fiches → code ISO 3166 numérique (world-atlas)
const ISO: Record<string, string> = {
  'France': '250', 'RDC': '180', 'République démocratique du Congo': '180', 'Cameroun': '120', 'Congo': '178',
  'République centrafricaine': '140', 'Tunisie': '788', 'Panama': '591', 'Nouvelle-Calédonie': '540',
  'Timor-Leste': '626', 'Sénégal': '686', 'Italie': '380', 'Guinée équatoriale': '226', 'Gabon': '266',
  'Arménie': '051', 'Vanuatu': '548', 'Togo': '768', 'Thaïlande': '764', 'Sri Lanka': '144', 'Niger': '562',
  'Maroc': '504', 'Mali': '466', 'Madagascar': '450', 'Inde': '356', 'Haïti': '332', "Côte d'Ivoire": '384',
  'Burundi': '108', 'Brésil': '076', 'Bolivie': '068', 'Laos': '418', 'Tchad': '148', 'Guyane': '254',
  'Indonésie': '360', 'Pérou': '604', 'Colombie': '170', 'Burkina Faso': '854', 'Bénin': '204', 'Ghana': '288',
  'Guinée': '324', 'Éthiopie': '231', 'Kenya': '404', 'Ouganda': '800', 'Rwanda': '646', 'Tanzanie': '834',
  'Mozambique': '508', 'Cambodge': '116', 'Viêt Nam': '704', 'Vietnam': '704', 'Philippines': '608', 'Mexique': '484',
  'Guatemala': '320', 'Honduras': '340', 'Nicaragua': '558', 'Équateur': '218', 'Algérie': '012', 'Égypte': '818',
  'Liban': '422', 'Jordanie': '400', 'Mauritanie': '478', 'Belgique': '056', 'Espagne': '724', 'Portugal': '620',
};
// Positions manuelles pour les territoires absents ou minuscules à cette échelle [lon, lat]
const POS: Record<string, [number, number]> = {
  '540': [165.6, -21.3], '548': [167.0, -15.4], '254': [-53.1, 3.9], '250': [2.4, 46.6],
};

// n = nombre de missions (libellés) ; annees = années-mission cumulées (taille du point),
// pour qu'un programme pluriannuel pèse plus qu'une mission ponctuelle
const comptes = new Map<string, { nom: string; n: number; annees: number }>();
const inconnus: string[] = [];
for (const p of projets) {
  for (const c of p.data.countries) {
    const id = ISO[c];
    if (!id) { inconnus.push(c); continue; }
    const cur = comptes.get(id) ?? { nom: c, n: 0, annees: 0 };
    cur.n += 1;
    const debut = p.data.year_start ?? p.data.date?.getFullYear?.() ?? 0;
    const fin = p.data.year_end ?? debut;
    cur.annees += debut ? Math.min(Math.max(fin - debut + 1, 1), 8) : 1;
    comptes.set(id, cur);
  }
}
if (inconnus.length) console.warn('[CarteTerrains] pays sans code ISO :', [...new Set(inconnus)].join(', '));

const W = 960, H = 430;
// @ts-ignore — typage topojson
const pays = feature(world, world.objects.countries).features.filter((f: any) => f.id !== '010');
// Cadrage sur la bande habitée utile (Amériques → Pacifique, Patagonie et Arctique rognés)
const cadre = { type: 'MultiPoint', coordinates: [[-112, -36], [178, -36], [-112, 62], [178, 62], [30, 68]] };
const projection = geoEqualEarth().fitExtent([[6, 6], [W - 6, H - 6]], cadre as any);
const path = geoPath(projection);
const r1 = (d: string | null) => (d ?? '').replace(/(\d+\.\d)\d+/g, '$1');

const formes = pays.map((f: any) => ({ id: String(f.id), d: r1(path(f)) }));
const points = [...comptes.entries()].map(([id, { nom, n, annees }]) => {
  const f = pays.find((x: any) => String(x.id) === id);
  const ll = POS[id] ?? (f ? (geoCentroid(f) as [number, number]) : null);
  const xy = ll ? projection(ll) : null;
  return xy ? { id, nom, n, x: +xy[0].toFixed(1), y: +xy[1].toFixed(1), r: +(3 + Math.sqrt(annees) * 2.2).toFixed(1) } : null;
}).filter(Boolean).sort((a: any, b: any) => b.n - a.n) as { id: string; nom: string; n: number; x: number; y: number; r: number }[];

const nbPays = comptes.size;
---

<figure class="carte">
  <svg viewBox={`0 0 ${W} ${H}`} overflow="hidden" role="img" aria-labelledby="carte-titre carte-desc">
    <title id="carte-titre">Pays d'intervention d'Agrarian Systems Consulting</title>
    <desc id="carte-desc">{points.map((p) => `${p.nom} (${p.n})`).join(', ')}</desc>
    <g class="terres">
      {formes.map((f) => <path d={f.d} class:list={{ actif: comptes.has(f.id) }} />)}
    </g>
    <g class="points">
      {points.map((p) => (
        <a href={`/projets/references/?pays=${encodeURIComponent(p.nom)}`} aria-label={`${p.nom} : ${p.n} mission${p.n > 1 ? 's' : ''}`}>
          <circle cx={p.x} cy={p.y} r={p.r} />
          <title>{p.nom} : {p.n} mission{p.n > 1 ? 's' : ''}</title>
        </a>
      ))}
    </g>
  </svg>
  <figcaption>
    <slot name="legende">{nbPays} pays d'intervention. Chaque point ouvre la liste des missions menées dans le pays.</slot>
  </figcaption>
</figure>

<style>
  .carte { margin: 0; }
  svg { display: block; width: 100%; height: auto; }
  .terres path { fill: #e6dac4; stroke: #f7f0e3; stroke-width: 0.6; }
  .terres path.actif { fill: #b9ab84; }
  .points circle {
    fill: var(--color-accent);
    fill-opacity: 0.85;
    stroke: #f7f0e3;
    stroke-width: 1.5;
    transition: fill 0.15s ease;
  }
  .points a:hover circle, .points a:focus-visible circle { fill: var(--color-accent-2); fill-opacity: 1; }
  .points a:focus-visible { outline: none; }
  figcaption { font-size: 0.85rem; color: var(--color-muted-text); margin-top: 0.75rem; }
</style>
