---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-identity">
      <img src="/brand/Logo_asc_vert.svg" alt="Agrarian Systems Consulting" class="footer-logo" />
      <p class="footer-tagline">Bureau d'étude des systèmes agraires et alimentaires du Monde</p>
    </div>
    <address class="footer-contact">
      <span>430 chemin de l'Hirondelle<br />34170 Castelnau-le-Lez</span>
      <a href="mailto:hugo@agrarian-systems.org">hugo@agrarian-systems.org</a>
      <a href="tel:+33789674743">+33 7 89 67 47 43</a>
    </address>
    <nav aria-label="Liens secondaires">
      <a href="/projets/references/">Références</a>
      <a href="/publications/">Publications</a>
      <a href="/territoires/">Territoires</a>
      <a href="/equipe/">Équipe</a>
      <a href="/contact/">Contact</a>
      <a href="/mentions-legales/">Mentions légales</a>
    </nav>
    <p class="footer-copy">© 2018–{year} Agrarian Systems Consulting, SARL, SIREN 839 389 459</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: var(--color-bg-soft);
    padding: 3rem 1.5rem 2rem;
    margin-top: 0;
  }
  .footer-inner {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1.4fr 1fr auto;
    align-items: start;
  }
  .footer-identity { display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  .footer-logo {
    height: 64px;
    width: auto;
    background: var(--color-bg-soft);
    border-radius: 8px;
    padding: 10px 14px;
  }
  .footer-tagline {
    font-size: 0.9rem;
    color: var(--color-soft);
    margin: 0;
  }
  .site-footer nav {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.9rem;
  }
  .footer-contact { font-style: normal; display: flex; flex-direction: column; gap: 0.45rem; font-size: 0.9rem; line-height: 1.5; }
  .footer-contact a { color: var(--color-bg-soft); border-bottom: 1px solid rgba(247,240,227,.3); align-self: flex-start; }
  .footer-contact a:hover { color: var(--color-highlight); }
  .site-footer nav a {
    color: var(--color-bg-soft);
    border-bottom: 1px solid transparent;
  }
  .site-footer nav a:hover { color: var(--color-highlight); }
  .footer-copy {
    grid-column: 1 / -1;
    font-size: 0.8rem;
    color: #ffffff;
    margin: 1.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(247, 240, 227, 0.15);
  }
  @media (max-width: 640px) {
    .footer-inner { grid-template-columns: 1fr; }
  }
</style>
